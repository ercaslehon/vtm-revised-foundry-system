<form class="vtm-character-wizard-form demon-character-wizard-form">
  <div class="vtm-wizard-layout">
    <aside class="vtm-wizard-sidebar">
      <h2>Создание демона</h2>
      <ol class="vtm-wizard-steps">{{#each steps as |step|}}<li><button type="button" class="wizard-step-button {{#if step.active}}active{{/if}} {{#if step.done}}done{{/if}}" data-step="{{step.index}}"><span>{{step.index}}</span>{{step.title}}</button></li>{{/each}}</ol>
      <div class="vtm-wizard-checklist-mini">
        {{#each checklist.rows as |row|}}<div class="wizard-mini-row status-{{row.status}}"><b>{{row.icon}}</b> {{row.label}}: {{row.actual}}/{{row.expected}}</div>{{/each}}
        <div class="wizard-freebie-mini {{#if checklist.negative}}is-negative{{/if}}">Свободные очки: <b>{{checklist.remaining}}</b></div>
      </div>
    </aside>
    <main class="vtm-wizard-main">
      <header class="vtm-wizard-header"><div><h1>{{actor.name}}</h1><p>Пошаговое создание персонажа Demon: The Fallen.</p></div><button type="button" class="wizard-save"><i class="fas fa-save"></i> Сохранить</button></header>

      {{#if (eq stepKey "identity")}}
      <section class="wizard-panel"><h2>Основа персонажа</h2><div class="demon-wizard-identity-grid">
        <article class="wizard-subpanel demon-wizard-identity-column"><label>Имя персонажа<input name="name" value="{{actor.name}}"/></label><label>Имя носителя<input name="system.profile.hostName" value="{{system.profile.hostName}}"/></label></article>
        <article class="wizard-subpanel demon-wizard-identity-column"><label>Дом<span class="demon-wizard-select-book"><select name="system.profile.house"><option value=""></option>{{selectOptions houses selected=system.profile.house valueAttr="key" labelAttr="label"}}</select><button type="button" class="demon-wizard-reference" data-catalog="houses" data-select="[name='system.profile.house']"><i class="fas fa-book-open"></i></button></span></label><div class="demon-wizard-torment-start"><label>Постоянная Мука<input type="number" name="system.resources.torment.max" value="{{system.resources.torment.max}}" min="0" max="10" readonly/></label><label>Временная Мука<input type="number" name="system.resources.torment.value" value="{{system.resources.torment.value}}" min="0" max="10"/></label><p class="wizard-hint">Постоянная Мука определяется Домом ({{initialTorment}}), временная начинается с 0.</p></div><label>Фракция<span class="demon-wizard-select-book"><select name="system.profile.faction"><option value=""></option>{{selectOptions factions selected=system.profile.faction valueAttr="key" labelAttr="label"}}</select><button type="button" class="demon-wizard-reference" data-catalog="factions" data-select="[name='system.profile.faction']"><i class="fas fa-book-open"></i></button></span></label><label>Натура<span class="demon-wizard-select-book"><select name="system.profile.nature"><option value=""></option>{{selectOptions archetypes selected=system.profile.nature valueAttr="name" labelAttr="name"}}</select><button type="button" class="demon-wizard-reference" data-catalog="archetypes" data-select="[name='system.profile.nature']"><i class="fas fa-book-open"></i></button></span></label><label>Маска<span class="demon-wizard-select-book"><select name="system.profile.demeanor"><option value=""></option>{{selectOptions archetypes selected=system.profile.demeanor valueAttr="name" labelAttr="name"}}</select><button type="button" class="demon-wizard-reference" data-catalog="archetypes" data-select="[name='system.profile.demeanor']"><i class="fas fa-book-open"></i></button></span></label></article>
      </div></section>{{/if}}

      {{#if (eq stepKey "attributes")}}<section class="wizard-panel"><h2>Характеристики 7/5/3</h2><p class="wizard-hint">Каждая характеристика начинается с 1. В распределение считаются точки сверх базовой.</p><div class="wizard-trait-groups">{{#each attributeGroups as |group|}}<article class="wizard-trait-group" data-trait-base="1"><header><h3>{{group.label}}</h3><select class="wizard-priority-select" data-type="attribute" data-group="{{group.group}}"><option value="7" {{#if (eq group.target 7)}}selected{{/if}}>7</option><option value="5" {{#if (eq group.target 5)}}selected{{/if}}>5</option><option value="3" {{#if (eq group.target 3)}}selected{{/if}}>3</option></select><span class="wizard-fact">{{group.total}}/{{group.target}}</span></header>{{#each group.traits as |trait|}}<label class="wizard-dot-row">{{trait.label}}<input type="number" name="{{trait.path}}" value="{{trait.value}}" min="1" max="5"/></label>{{/each}}</article>{{/each}}</div></section>{{/if}}

      {{#if (eq stepKey "abilities")}}<section class="wizard-panel"><h2>Способности 13/9/5</h2><p class="wizard-hint">На первичном этапе способность не должна быть выше 3.</p><div class="wizard-trait-groups">{{#each abilityGroups as |group|}}<article class="wizard-trait-group" data-trait-base="0"><header><h3>{{group.label}}</h3><select class="wizard-priority-select" data-type="ability" data-group="{{group.group}}"><option value="13" {{#if (eq group.target 13)}}selected{{/if}}>13</option><option value="9" {{#if (eq group.target 9)}}selected{{/if}}>9</option><option value="5" {{#if (eq group.target 5)}}selected{{/if}}>5</option></select><span class="wizard-fact">{{group.total}}/{{group.target}}</span></header>{{#each group.traits as |trait|}}<label class="wizard-dot-row">{{trait.label}}<input type="number" name="{{trait.path}}" value="{{trait.value}}" min="0" max="5"/></label>{{/each}}</article>{{/each}}</div></section>{{/if}}

      {{#if (eq stepKey "advantages")}}<section class="wizard-panel"><h2>Преимущества</h2><div class="wizard-columns-2"><article class="wizard-subpanel"><div class="wizard-trait-group" data-trait-base="1" data-trait-target="{{virtueTarget}}"><header><h3>Добродетели</h3><span class="wizard-fact">{{virtueTotal}}/{{virtueTarget}}</span></header><p class="wizard-hint">Каждая Добродетель начинается с 1. Распредели ещё 3 очка.</p>{{#each virtues as |row|}}<label class="wizard-dot-row">{{row.label}}<input type="number" name="system.virtues.{{row.key}}" value="{{row.value}}" min="1" max="5"/></label>{{/each}}</div><button type="button" class="wizard-fix-willpower">Воля = две высшие Добродетели</button><div class="wizard-trait-group" data-trait-base="0" data-trait-target="{{backgroundTarget}}"><header><h3>Дополнения</h3><span class="wizard-fact">{{backgroundTotal}}/{{backgroundTarget}}</span></header>{{#each backgrounds as |row|}}<div class="wizard-dot-row demon-wizard-rated-row"><label>{{row.label}}<input type="number" name="system.backgrounds.{{row.key}}.value" value="{{row.value}}" min="0" max="5"/></label><button type="button" class="demon-wizard-reference" data-catalog="backgrounds" data-key="{{row.key}}"><i class="fas fa-book-open"></i></button></div>{{/each}}</div></article><article class="wizard-subpanel wizard-trait-group" data-trait-base="0" data-trait-target="{{loreTarget}}"><header><h3>Знания</h3><span class="wizard-fact">{{loreTotal}}/{{loreTarget}}</span></header>{{#if hasHouseLores}}<div class="demon-wizard-primary-lore"><label><b>Основное Знание</b><select name="system.creation.primaryLore">{{selectOptions houseLoreOptions selected=primaryLore valueAttr="key" labelAttr="label"}}</select></label><button type="button" class="demon-wizard-reference" data-catalog="lores" data-select="[name='system.creation.primaryLore']"><i class="fas fa-book-open"></i></button><p class="wizard-hint">Определяет апокалиптическую форму и должно иметь наивысшее значение среди Знаний.</p></div>{{/if}}{{#unless hasHouseLores}}<p class="wizard-warning">Выбери Дом, чтобы автоматически показать его Знания.</p>{{/unless}}{{#if loreOptions.length}}<div class="wizard-add-row"><select name="wizard.loreKey">{{selectOptions loreOptions valueAttr="key" labelAttr="label"}}</select><button type="button" class="demon-wizard-reference" data-catalog="lores" data-select="[name='wizard.loreKey']"><i class="fas fa-book-open"></i></button><button type="button" class="demon-wizard-add-lore"><i class="fas fa-plus"></i></button></div>{{/if}}<ol class="wizard-item-list">{{#each selectedLores as |row|}}<li><button type="button" class="demon-wizard-reference" data-catalog="lores" data-key="{{row.key}}"><i class="fas fa-book-open"></i></button><span>{{row.label}}</span><input type="number" name="system.lores.{{row.key}}.value" value="{{row.value}}" min="0" max="5"/>{{#if row.recommended}}<span class="demon-wizard-recommended-lore" title="Знание Дома или общее Знание"><i class="fas fa-star"></i></span>{{else}}<button type="button" class="demon-wizard-remove-lore" data-key="{{row.key}}"><i class="fas fa-trash"></i></button>{{/if}}</li>{{else}}<li class="empty">Знания ещё не выбраны</li>{{/each}}</ol></article></div></section>{{/if}}

      {{#if (eq stepKey "freebies")}}<section class="wizard-panel"><h2>Свободные очки</h2><div class="freebie-pool-row"><label>Базовый запас <input type="number" name="system.creation.freebiePool" value="{{checklist.pool}}"/></label><b class="{{#if checklist.negative}}is-negative{{/if}}">Осталось: {{checklist.remaining}}</b></div><table class="freebie-table wizard-freebie-table"><thead><tr><th>Покупка (цена за точку)</th><th>Расчёт</th><th>Баланс</th></tr></thead><tbody>{{#each checklist.freebieRows as |row|}}<tr><th>{{row.label}}</th><td>{{row.display}}</td><td>{{row.costDisplay}}</td></tr>{{/each}}</tbody><tfoot><tr><th>Остаток</th><td colspan="2" class="{{#if checklist.negative}}is-negative{{else}}is-ok{{/if}}">{{checklist.remaining}}</td></tr></tfoot></table><div class="wizard-columns-2"><article class="wizard-subpanel"><h3>Достоинства</h3><div class="wizard-add-row"><select name="wizard.meritsKey">{{selectOptions meritsAvailable valueAttr="key" labelAttr="label"}}</select><button type="button" class="demon-wizard-reference" data-catalog="merits" data-select="[name='wizard.meritsKey']"><i class="fas fa-book-open"></i></button><button type="button" class="demon-wizard-add-feature" data-catalog="merits"><i class="fas fa-plus"></i></button></div><ol class="wizard-item-list">{{#each meritsSelected as |entry|}}<li><button type="button" class="demon-wizard-reference" data-catalog="merits" data-key="{{entry.key}}"><i class="fas fa-book-open"></i></button><span>{{entry.label}}</span>{{#if entry.variableCost}}<input class="demon-wizard-feature-cost" data-catalog="merits" data-key="{{entry.key}}" type="number" value="{{entry.effectiveCost}}" min="1" max="5"/>{{else}}<b>{{entry.effectiveCost}}</b>{{/if}}<button type="button" class="demon-wizard-remove-feature" data-catalog="merits" data-key="{{entry.key}}"><i class="fas fa-trash"></i></button></li>{{/each}}</ol></article><article class="wizard-subpanel"><h3>Недостатки</h3><div class="wizard-add-row"><select name="wizard.flawsKey">{{selectOptions flawsAvailable valueAttr="key" labelAttr="label"}}</select><button type="button" class="demon-wizard-reference" data-catalog="flaws" data-select="[name='wizard.flawsKey']"><i class="fas fa-book-open"></i></button><button type="button" class="demon-wizard-add-feature" data-catalog="flaws"><i class="fas fa-plus"></i></button></div><ol class="wizard-item-list">{{#each flawsSelected as |entry|}}<li><button type="button" class="demon-wizard-reference" data-catalog="flaws" data-key="{{entry.key}}"><i class="fas fa-book-open"></i></button><span>{{entry.label}}</span>{{#if entry.variableCost}}<input class="demon-wizard-feature-cost" data-catalog="flaws" data-key="{{entry.key}}" type="number" value="{{entry.effectiveCost}}" min="1" max="5"/>{{else}}<b>{{entry.effectiveCost}}</b>{{/if}}<button type="button" class="demon-wizard-remove-feature" data-catalog="flaws" data-key="{{entry.key}}"><i class="fas fa-trash"></i></button></li>{{/each}}</ol></article></div></section>{{/if}}

      {{#if (eq stepKey "biographies")}}<section class="wizard-panel demon-wizard-biographies"><h2>Биографии</h2><p class="wizard-hint">Этот шаг необязательный. Его можно пропустить и заполнить позднее.</p><div class="wizard-columns-2"><article class="wizard-subpanel"><h3>Биография человека</h3><p class="wizard-hint">Жизнь носителя до появления падшего: происхождение, близкие, профессия, ключевые события и обстоятельства одержимости.</p><textarea name="system.profile.hostHistory" rows="18" placeholder="Опиши историю человека-носителя...">{{system.profile.hostHistory}}</textarea></article><article class="wizard-subpanel"><h3>Биография ангела</h3><p class="wizard-hint">Небесная служба, Дом, роль в Восстании, Век Гнева, заключение в Бездне и возвращение в мир.</p><textarea name="system.profile.celestialHistory" rows="18" placeholder="Опиши историю ангела...">{{system.profile.celestialHistory}}</textarea></article></div></section>{{/if}}

      {{#if (eq stepKey "apocalypticForm")}}<section class="wizard-panel demon-wizard-apocalyptic-form"><h2>Апокалиптическая форма</h2><p class="wizard-hint">Форма автоматически определяется Основным Знанием по правилам Demon: The Fallen. Подставленный текст можно редактировать.</p>{{#if canonicalForm}}<div class="demon-wizard-form-source"><span><b>{{canonicalForm.name}}</b> · Основное Знание: {{primaryLoreLabel}}</span><button type="button" class="demon-wizard-reset-apocalyptic"><i class="fas fa-rotate-left"></i> Восстановить по Знанию</button></div>{{else}}<p class="wizard-warning">Выбери Дом и Основное Знание на вкладке «Преимущества».</p>{{/if}}<label>Название формы<input name="system.apocalypticForm.name" value="{{apocalypticForm.name}}" placeholder="Название апокалиптической формы..."/></label><div class="wizard-columns-2"><article class="wizard-subpanel"><h3>Общее описание</h3><textarea name="system.apocalypticForm.description" rows="10" placeholder="Внешность, голос, аура и особенности формы...">{{apocalypticForm.description}}</textarea><h3>Обычные свойства</h3><textarea name="system.apocalypticForm.lowTorment" rows="12" placeholder="Четыре свойства апокалиптической формы...">{{apocalypticForm.lowTorment}}</textarea></article><article class="wizard-subpanel"><h3>Высокая Мука</h3><textarea name="system.apocalypticForm.highTorment" rows="12" placeholder="Изменение облика и четыре свойства высокой Муки...">{{apocalypticForm.highTorment}}</textarea><h3>Механика и заметки</h3><textarea name="system.apocalypticForm.mechanics" rows="10" placeholder="Игровые эффекты и заметки...">{{apocalypticForm.mechanics}}</textarea></article></div></section>{{/if}}

      {{#if (eq stepKey "summary")}}<section class="wizard-panel"><h2>Проверка готовности</h2><div class="wizard-summary-grid">{{#each checklist.rows as |row|}}<article class="wizard-subpanel"><h3>{{row.icon}} {{row.label}}</h3><p>Факт: <b>{{row.actual}}</b>; ожидается: <b>{{row.expected}}</b></p>{{#if row.warning}}<p class="wizard-hint">{{row.warning}}</p>{{/if}}</article>{{/each}}</div><article class="wizard-subpanel"><h3>Свободные очки</h3><p>База {{checklist.pool}} + недостатки {{checklist.creditedFlawPoints}} (выбрано {{checklist.flawPoints}}, максимум 7) − потрачено {{checklist.spent}} = <b class="{{#if checklist.negative}}is-negative{{/if}}">{{checklist.remaining}}</b></p></article></section>{{/if}}
    </main>
  </div>
  <footer class="vtm-wizard-footer"><button type="button" class="wizard-prev" {{#if isFirst}}disabled{{/if}}><i class="fas fa-arrow-left"></i> Назад</button>{{#if isLast}}<button type="button" class="wizard-finish"><i class="fas fa-check"></i> Готово</button>{{else}}<button type="button" class="wizard-next">Далее <i class="fas fa-arrow-right"></i></button>{{/if}}</footer>
</form>
